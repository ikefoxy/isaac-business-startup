{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview BYU ByteBack on localhost",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "py"
      },
      "args": ["server.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "detail": "Runs the functional MVP with accounts and saved orders. Open http://localhost:4173/app.html. Requires Python 3. Stop with Ctrl+C."
    }
  ]
}
