# Copy to .env. Default mode is a local demo; no credentials required.
BYTEBACK_MODE=demo
PORT=4173
PUBLIC_URL=http://localhost:4173

# Live mode requires an HTTPS reverse proxy and all SMTP settings below.
# Keep test and live databases separate.
# BYTEBACK_MODE=live
# PUBLIC_URL=https://your-domain.example
# BYTEBACK_DB=.data/live.sqlite3
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_FROM=ByteBack <receipts@your-domain.example>
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# ADMIN_EMAILS=organizer@your-domain.example
# DROPOFF_DESCRIPTION=Your confirmed collection location and opening hours

# EasyPost USPS/FedEx label purchasing and carrier tracking.
# Use a test key first. Production keys purchase real postage using your funds.
# EASYPOST_API_KEY=your-test-or-live-key
# SHIP_TO_JSON={"name":"ByteBack","street1":"YOUR REAL RECEIVING ADDRESS","city":"Provo","state":"UT","zip":"84601","country":"US","phone":"YOUR PHONE"}
# MAX_LABEL_USD=25
